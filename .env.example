# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack — https://paystack.com
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Arkesel SMS — https://arkesel.com
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=

# --- Suppliers ---------------------------------------------------------------
# Per-network routing. Each network can use a different upstream supplier.
# Supported ids: "skanka5", "successbizhub", "manual" (queued for admin fulfilment).
# Register new modules in src/lib/suppliers/registry.ts.
SUPPLIER_FOR_MTN=skanka5
SUPPLIER_FOR_TELECEL=successbizhub
SUPPLIER_FOR_AT=manual

# Skanka5 data supplier — https://agent.skanka5.com/api/v1 (currently MTN only)
SKANKA5_API_KEY=
SKANKA5_WEBHOOK_SECRET=
# Optional override of supplier base URL (defaults to https://agent.skanka5.com/api/v1)
# SKANKA5_BASE_URL=
# Map your internal network slug to the Skanka5 numeric network_id
# (call GET /fetch-networks once to discover IDs for your account).
SKANKA5_NETWORK_ID_MTN=3
# Only set these if you actually want Skanka5 to handle Telecel/AT — otherwise
# point SUPPLIER_FOR_TELECEL / SUPPLIER_FOR_AT at a different supplier id.
SKANKA5_NETWORK_ID_TELECEL=
SKANKA5_NETWORK_ID_AT=
# DIAGNOSTIC ONLY — set to "1" to accept webhooks without HMAC signature checks.
# Use this when Skanka5 has not yet given you a webhook secret so you can test
# end-to-end. NEVER leave this on in production: anyone who finds your endpoint
# URL can mark orders as fulfilled.
SKANKA5_ALLOW_UNSIGNED_WEBHOOKS=

# Success Biz Hub — https://documenter.getpostman.com/view/36783125/2sBXcLfxJU
# Auth: x-api-key header. Set SUPPLIER_FOR_<NETWORK>=successbizhub to route a network here.
SUCCESSBIZHUB_API_KEY=
# SUCCESSBIZHUB_BASE_URL=https://www.successbizhub.com/api/v1
# Offer slugs from GET /offers (e.g. mtn_data_bundle). Required per network you automate.
SUCCESSBIZHUB_OFFER_SLUG_MTN=
SUCCESSBIZHUB_OFFER_SLUG_TELECEL=
SUCCESSBIZHUB_OFFER_SLUG_AT=
# Path segment for AT if not "at" (docs also accept airteltigo)
# SUCCESSBIZHUB_NETWORK_AT=at
# Webhook URL sent on each order (defaults to NEXT_PUBLIC_SITE_URL/api/webhooks/successbizhub)
# SUCCESSBIZHUB_WEBHOOK_URL=

# iShare / MultiData Ghana — AT data console fulfilment
# Route with SUPPLIER_FOR_AT=ishare or Admin → Supplier routing.
ISHARE_API_KEY=
# ISHARE_MERCHANT_SLUG=divinelychosenstar
# ISHARE_BASE_URL=https://multidataghana.com

# Vendor store setup fee (GHS)
VENDOR_STORE_SETUP_FEE_GHS=50
NEXT_PUBLIC_VENDOR_STORE_SETUP_FEE_GHS=50
