# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional aliases used by storage / console routing
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_CONSOLE_URL=http://localhost:3000
# NEXT_PUBLIC_CONSOLE_HOST=console.localhost

# -----------------------------------------------------------------------------
# Database mode (pick ONE)
# -----------------------------------------------------------------------------

# A) Plain Postgres (staging / Coolify cutover) — preferred for this branch
DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/store_dcs
# POSTGRES_URL=  # alias accepted by the pool
AUTH_JWT_SECRET=change-me-to-a-long-random-string
# JWT_SECRET=    # alias
# SUPABASE_JWT_SECRET=  # alias

# Pool / TLS
# PG_POOL_MAX=10
# PGSSL=require

# Local file storage (replaces Supabase Storage)
# STORAGE_ROOT=.storage
# STORAGE_PUBLIC_URL=http://localhost:3000
# STORAGE_SIGNING_SECRET=change-me

# Browser SDK + GoTrue/PostgREST shims: point URL at THIS app in plain-PG mode
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_ANON_KEY=plain-pg-anon-key
# Optional service-role stand-in for maintenance REST fetches
SUPABASE_SERVICE_ROLE_KEY=plain-pg-service-key

# B) Hosted Supabase (legacy production until cutover)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Payments — Paystack (+ MoMo Direct / ClaimIt via platform_settings in DB)
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Note: Moolre and Hubtel are NOT implemented in this codebase.
# Customer checkout uses Paystack and/or MoMo Direct (SMS forwarder).

# -----------------------------------------------------------------------------
# SMS — Arkesel (outbound). Moolre SMS is NOT used.
# -----------------------------------------------------------------------------
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=

# Cron protection (wallet top-up reconcile, railway poll)
CRON_SECRET=

# Optional global maintenance override (middleware; edge-safe)
# MAINTENANCE_MODE=false
# MAINTENANCE_MESSAGE=

# Railway / NovaMax external wholesale API — BOTH key and base URL are required.
# Route with SUPPLIER_FOR_TELECEL=railwayexternal (or Admin → Supplier).
# Live host (NovaMax): https://api.novamaxgh.com/api/external
# The old backend-production-1d8b.up.railway.app host is DEAD.
RAILWAY_EXTERNAL_API_KEY=
RAILWAY_EXTERNAL_BASE_URL=https://api.novamaxgh.com/api/external
# Optional product ID overrides when catalogue name-matching fails:
# RAILWAY_PRODUCT_ID_TELECEL_5GB=
# RAILWAY_PRODUCT_ID_MTN_1GB=
# RAILWAY_PRODUCT_ID_AT_1GB=

# Vendor store setup fee (GHS)
VENDOR_STORE_SETUP_FEE_GHS=50
NEXT_PUBLIC_VENDOR_STORE_SETUP_FEE_GHS=50

# --- Suppliers ---------------------------------------------------------------
# Per-network routing. Each network can use a different upstream supplier.
# Supported ids: "skanka5", "successbizhub", "shopdcs", "manual", "ishare", "railwayexternal"
SUPPLIER_FOR_MTN=skanka5
SUPPLIER_FOR_TELECEL=shopdcs
SUPPLIER_FOR_AT=manual

# Shop DCS (shopdcsgh.com) — Telecel fulfilment
SHOP_DCS_API_KEY=
# SHOP_DCS_BASE_URL=https://shopdcsgh.com/api/v1
SHOP_DCS_NETWORK_ID_TELECEL=2
# SHOP_DCS_SHARED_BUNDLE_UNIT=mb

# Skanka5 data supplier — https://agent.skanka5.com/api/v1
SKANKA5_API_KEY=
SKANKA5_WEBHOOK_SECRET=
# SKANKA5_BASE_URL=
SKANKA5_NETWORK_ID_MTN=3
SKANKA5_NETWORK_ID_TELECEL=
SKANKA5_NETWORK_ID_AT=
# DIAGNOSTIC ONLY — never leave on in production
SKANKA5_ALLOW_UNSIGNED_WEBHOOKS=

# Success Biz Hub
SUCCESSBIZHUB_API_KEY=
# SUCCESSBIZHUB_BASE_URL=https://www.successbizhub.com/api/v1
SUCCESSBIZHUB_OFFER_SLUG_MTN=
SUCCESSBIZHUB_OFFER_SLUG_TELECEL=
SUCCESSBIZHUB_OFFER_SLUG_AT=
# SUCCESSBIZHUB_NETWORK_AT=at
# SUCCESSBIZHUB_WEBHOOK_URL=

# iShare / MultiData Ghana — AT data console fulfilment
ISHARE_API_KEY=
# ISHARE_MERCHANT_SLUG=divinelychosenstar
# ISHARE_BASE_URL=https://multidataghana.com
